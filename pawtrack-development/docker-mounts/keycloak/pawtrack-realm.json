{
  "realm": "pawtrack",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Regular PawTrack user" },
      { "name": "ADMIN", "description": "Platform administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "pawtrack-ui",
      "name": "PawTrack Angular UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:4200/*" }
    },
    {
      "clientId": "pawtrack-e2e",
      "name": "E2E tests (local only, password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "alice@pawtrack.local",
      "email": "alice@pawtrack.local",
      "firstName": "Alice",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["USER", "ADMIN"]
    },
    {
      "username": "bob@pawtrack.local",
      "email": "bob@pawtrack.local",
      "firstName": "Bob",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["USER"]
    }
  ]
}
